# Variables de entorno de RifaPlus. Copie este archivo como .env y llene los valores en el servidor.
# Nunca suba el .env real a Git ni lo comparta.

# --- Aplicación ---
# Nombre que se muestra en la app (opcional).
APP_NOMBRE=RifaPlus
# "produccion" en el servidor (activa cookies seguras, oculta /docs y exige claves reales); "desarrollo" en su Mac.
APP_ENTORNO=
# Dirección pública de la app, con https. Se usa en los enlaces de los correos, el QR y WhatsApp.
APP_URL=
# Clave larga y secreta (mínimo 32 caracteres). Genérela con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CLAVE_SECRETA=

# --- Base de datos ---
# Conexión a PostgreSQL. Formato: postgresql://USUARIO:CLAVE@HOST:5432/BASE (también acepta postgresql+psycopg://).
DATABASE_URL=
# 1 = al arrancar el contenedor aplica las migraciones y los datos iniciales; 0 = no (los corre usted a mano).
MIGRAR_AL_ARRANCAR=1

# --- Sesiones y seguridad ---
# Horas que dura una sesión abierta.
SESION_HORAS=8
# Intentos fallidos de clave antes de bloquear la cuenta.
MAX_INTENTOS_FALLIDOS=5
# Minutos que dura ese bloqueo.
MINUTOS_BLOQUEO=15

# --- Archivos subidos (fotos de premios y comprobantes) ---
# Carpeta donde se guardan. En Docker es /app/uploads: monte ahí un volumen.
CARPETA_ARCHIVOS=/app/uploads
# Tamaño máximo de cada archivo, en MB.
MAX_MB_COMPROBANTE=5

# --- Correo de salida (clave temporal, «olvidé mi clave», avisos) ---
# Servidor SMTP. Con Gmail: smtp.gmail.com y puerto 587.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
# Correo completo de la cuenta que envía.
SMTP_USUARIO=
# Contraseña de aplicación de esa cuenta (en Gmail: myaccount.google.com/apppasswords), no la clave normal.
SMTP_CLAVE=
# Remitente que ven los usuarios; si se deja vacío, se usa SMTP_USUARIO.
CORREO_REMITENTE=
# Correo del superadministrador para los avisos de pagos, renovaciones y soporte.
CORREO_AVISOS_ADMIN=

# --- Datos del responsable (salen en los términos y la política de datos) ---
RESPONSABLE_NOMBRE=
RESPONSABLE_DOCUMENTO=
RESPONSABLE_CIUDAD=
# Correo de contacto público para usuarios y reclamos.
CORREO_CONTACTO=

# --- Sistema ---
# Zona horaria del contenedor (ya viene así en la imagen).
TZ=America/Bogota
